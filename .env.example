# Set a strong, unique password in .env.local and in Cloudflare secrets.
# Never commit the real password to Git.
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Booking email notifications (Resend)
RESEND_API_KEY=re_xxxxxxxxx
BOOKING_NOTIFICATION_EMAIL=your-business-email@example.com
BOOKING_FROM_EMAIL=Elay Nail Bar <randevu@send.elaynailbar.com>

# Supabase server-side access. Never expose the service role key to the browser.
SUPABASE_URL=https://your-project.supabase.co/rest/v1
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key

# Protects the hourly Cloudflare reminder job endpoint.
CRON_SECRET=replace-with-another-long-random-secret
